<?xml version="1.0" encoding="utf-8"?>
<!--
  data 模块组件声明（merge 进 app）。
  M4 注册 NotificationListener 与 L2 无障碍服务（分类识别）；
  SmsReceiver / SmsScanWorker 在 M5/M6 补充。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        前台保活服务所需权限（普通权限，无需运行时申请）。
        因 targetSdk=35，必须声明 FOREGROUND_SERVICE 与对应类型权限，
        否则在 Android 14+ 启动前台服务会抛 SecurityException。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <service
            android:name="com.kai.bill.data.capture.notification.KaiNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            L2 无障碍服务：读取白名单 App 的页面文本，用于给账单补全分类。
            exported=false —— 该服务只由系统无障碍框架绑定，不需要（也不应该）对外暴露；
            BIND_ACCESSIBILITY_SERVICE 由系统持有，应用自身无该权限，
            因此第三方无法伪造绑定（这是无障碍服务的安全边界）。
        -->
        <service
            android:name="com.kai.bill.data.capture.accessibility.KaiAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            前台保活服务：辅助通知监听在后台存活，不保证监听永久在线。
            foregroundServiceType=dataSync 对应 FOREGROUND_SERVICE_DATA_SYNC 权限，
            满足 Android 14/15 对前台服务类型的强制要求。
        -->
        <service
            android:name="com.kai.bill.data.service.CaptureForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
